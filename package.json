    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@types/node": "^26.1.1",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  },
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "0.7.2"
    }
  }
