{
  "name": "slab",
  "version": "3.42.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "a11y:audit": "node scripts/audit-a11y.mjs",
    "a11y:audit:strict": "node scripts/audit-a11y.mjs --strict",
    "i18n:test": "node scripts/i18n-test.mjs",
    "loom:codegen": "node scripts/loom/codegen-matterhorn.mjs",
    "loom:codegen:check": "node scripts/loom/codegen-matterhorn.mjs --check",
    "tauri": "tauri",
    "test:split": "node --experimental-strip-types scripts/test-split-plan.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:pdf": "node --experimental-strip-types scripts/test-pdfops.mjs && node --experimental-strip-types scripts/test-mdtopdf.mjs",
    "test": "pnpm test:unit && pnpm test:split && pnpm test:pdf && pnpm i18n:test",
    "test:e2e": "playwright test",
    "test:native": "node scripts/test-native.mjs",
    "test:website": "playwright test --config=playwright.website.config.ts"
  },
