<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- JIT for WebKit / WKWebView -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Tauri/WebKit needs unsigned executable memory -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required by some libraries (lopdf, regex) doing dynamic loading -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- User-selected file access (open/save dialogs) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Apple events disabled — not used -->
  <key>com.apple.security.automation.apple-events</key>
  <false/>
</dict>
</plist>
